# Test stack environment (Docker Compose)

# Core
EMAIL=test_user@example.com
PASSWORD=test_password
MONGO_URI=mongodb://mongo:27017/
MONGO_DB=Lesson_test
PORT=80

# Keep test stack isolated and lightweight
PLANS_JSON_URL=
MOODLE_URL=http://127.0.0.1:80/panel
SAVE_TO_MONGODB=true
SAVE_TO_FILE=false
PLANS_DIRECTORY=lesson_plans
CLEAN_EXCEL_FILE=false
LOG_TO_FILE=true
LOG_DIR=logs
DEV=true

# Optional integrations disabled in test by default
OPENROUTER_API_KEY=
SELECTED_MODEL=openai/chatgpt-4o-latest
PUSHOVER_KEY=
PUSHOVER_USER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
