# ==============================================================================
# CORE CREDENTIALS - WYMAGANE
# ==============================================================================

# PUW Login Credentials (do pobierania plików Excel)
EMAIL=twoj_email@student.wspa.pl
PASSWORD=twoje_haslo_do_puw

# MongoDB Connection (przechowywanie planów)
MONGO_URI=mongodb://localhost:27017/
# lub dla MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

MONGO_DB=Lesson_dev

# ==============================================================================
# PATHS & DIRECTORIES - OPCJONALNE (mają domyślne wartości)
# ==============================================================================

# Gdzie zapisywać pliki planów lokalnie
PLANS_DIRECTORY=lesson_plans

# Czy zapisywać do MongoDB (domyślnie true)
SAVE_TO_MONGODB=true

# Czy zapisywać pliki lokalnie (domyślnie false)
SAVE_TO_FILE=false

# Czy wykonywać kosztowne clean_excel_file() (domyślnie false)
# Można nadpisać per-plan przez pole "clean_excel" w plans.json
CLEAN_EXCEL_FILE=false

# ==============================================================================
# MOODLE INTEGRATION - OPCJONALNE
# ==============================================================================

# URL kursu Moodle do parsowania aktywności
MOODLE_URL=https://puw.wspa.pl/course/view.php?id=12345

# ==============================================================================
# AI COMPARISON - OPCJONALNE (dla porównywania zmian w planach)
# ==============================================================================

# OpenRouter API dla AI comparisons
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxx

# Model do używania (domyślnie claude-3-haiku)
AI_MODEL=anthropic/claude-3-haiku

# ==============================================================================
# DISCORD NOTIFICATIONS - OPCJONALNE
# ==============================================================================

# Discord webhook URL dla powiadomień o zmianach
# (można też konfigurować per-plan w MongoDB)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ==============================================================================
# AWS CLOUDWATCH LOGS - OPCJONALNE
# ==============================================================================

# Dla wysyłania logów do CloudWatch
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=eu-central-1
CLOUDWATCH_LOG_GROUP=/aws/ec2/lesson-plans
CLOUDWATCH_LOG_STREAM=production

# ==============================================================================
# PUSHOVER NOTIFICATIONS - OPCJONALNE (dla sugestii użytkowników)
# ==============================================================================

PUSHOVER_KEY=azgxxxxxxxxxxxxxxxxxxxxxxxxxx
PUSHOVER_USER=uqixxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# FLASK APP SETTINGS - OPCJONALNE
# ==============================================================================

# Port dla Flask API (domyślnie 80)
PORT=5000

# Flask secret key (generuj losowy dla produkcji)
SECRET_KEY=your-secret-key-here-change-in-production

# Tryb debug (ustaw false na produkcji)
FLASK_DEBUG=false

# ==============================================================================
# BROWSER AUTOMATION - OPCJONALNE
# ==============================================================================

# Dla Selenium/Moodle parsing
HEADLESS_BROWSER=true

# Timeout dla pobierania plików (w sekundach)
DOWNLOAD_TIMEOUT=60

# ==============================================================================
# SCHEDULE SETTINGS - OPCJONALNE
# ==============================================================================

# Jak często sprawdzać plany (w sekundach, domyślnie 600 = 10 minut)
CHECK_INTERVAL=600

# Godziny kiedy sprawdzać (format: HH:MM-HH:MM)
CHECK_HOURS=06:00-22:00

# Dni tygodnia kiedy sprawdzać (0=poniedziałek, 6=niedziela)
CHECK_DAYS=0,1,2,3,4,5,6

# ==============================================================================
# MAINTENANCE MODE - OPCJONALNE
# ==============================================================================

# Tryb konserwacji (true = API zwraca status 503)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System w trakcie konserwacji. Wrócimy wkrótce!

# ==============================================================================
# PLANS CONFIGURATION - OPCJONALNE
# ==============================================================================

# URL do pliku plans.json (zamiast lokalnego)
PLANS_JSON_URL=https://example.com/plans.json

# Lub użyj lokalnego pliku (domyślnie)
# PLANS_JSON_FILE=plans.json
