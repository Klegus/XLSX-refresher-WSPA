# Copy to backend/.env

# PUW account used to download the plans (ideally a technical account from the university)
EMAIL=
PASSWORD=

# ─── Admin panel login (required - without them the panel refuses all requests) ──
# Generate both values with:  docker compose run --rm --no-deps admin python admin_auth.py hash
# Keep the hash in single quotes - it contains "$", which Docker Compose would expand
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
ADMIN_SECRET_KEY=
# "true" when the panel is served over HTTPS (e.g. behind Cloudflare Access);
# keep "false" for the SSH tunnel to http://127.0.0.1:5006
ADMIN_COOKIE_SECURE=false

# Key for pseudonymising visitor ids in the suggestion limit (random, >= 32 chars)
DEVICE_ID_SECRET=

# ─── Optional ───────────────────────────────────────────────
# AI summary of plan changes (OpenRouter)
# OPENROUTER_API_KEY=
# SELECTED_MODEL=openai/chatgpt-4o-latest
# Push notification about new user suggestions
# PUSHOVER_KEY=
# PUSHOVER_USER=
# Logs to AWS CloudWatch
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# Error reporting (Sentry)
# SENTRY_DSN=
# Hosts the backend may download plan files from (comma separated)
# ALLOWED_DOWNLOAD_HOSTS=puw.wspa.pl
# MAX_DOWNLOAD_MB=25
