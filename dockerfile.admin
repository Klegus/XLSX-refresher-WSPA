# Admin panel - lightweight image, no Selenium/heavy deps needed
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir --timeout=120 \
    Flask==3.0.3 \
    pymongo==4.10.0 \
    python-dotenv==1.0.1 \
    requests==2.32.3 \
    beautifulsoup4==4.12.3 \
    openpyxl==3.1.5 \
    lxml==5.3.0 \
    pytz==2024.2 \
    colorama==0.4.6 \
    boto3==1.35.77 \
    watchtower==2.0.1

# Copy only what admin needs
COPY admin_app.py ./
COPY shared_utils.py ./
COPY moodle_scanner.py ./
COPY LessonPlanDownloader.py ./
COPY routes/ routes/
COPY templates/ templates/

RUN addgroup --system app && adduser --system --group app \
    && chown -R app:app /app
USER app

EXPOSE 5006

CMD ["python", "-c", "from admin_app import run_admin_app; run_admin_app()"]
