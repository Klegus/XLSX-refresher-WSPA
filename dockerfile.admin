# Admin panel - lightweight image, no pandas/heavy deps needed
FROM python:3.14-slim

WORKDIR /app

COPY requirements-admin.txt .
RUN pip install --no-cache-dir --timeout=120 -r requirements-admin.txt

# Copy only what admin needs
COPY admin_app.py ./
COPY admin_auth.py ./
COPY shared_utils.py ./
COPY moodle_scanner.py ./
COPY plan_validator.py ./
COPY plan_reconciler.py ./
COPY plan_naming.py ./
COPY plan_notes.py ./
COPY exam_schedule.py ./
COPY plan_differ.py ./
COPY LessonPlanDownloader.py ./
COPY routes/ routes/
COPY templates/ templates/

# Local time for schedule logic (night pause, auto-scan window) and timestamps
ENV TZ=Europe/Warsaw

RUN addgroup --system app && adduser --system --group app \
    && chown -R app:app /app
USER app

EXPOSE 5006

CMD ["python", "-c", "from admin_app import run_admin_app; run_admin_app()"]
